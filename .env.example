# Configuración LOCAL. Copia este archivo a .env y funciona tal cual:
#
#   cp .env.example .env
#   docker compose up -d --build        → http://localhost:8090
#
# Los valores de abajo son de DEMOSTRACIÓN y públicos a propósito: solo sirven para
# una instalación local. Producción usa su propio fichero con secretos generados,
# ver .env.produccion.example.
#
# El .env está en .gitignore: nunca se sube al repositorio.

# ---------------------------------------------------------------------------
# Servidor (desarrollo sin Docker: npm run dev)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# URL del frontend en desarrollo (Vite). La usan el CORS, el enlace del correo y el
# portafolioUrl del 409. Nunca se escribe en el código: siempre sale de aquí.
APP_URL=http://localhost:5175

# Cuántos proxies hay delante del backend; de esto depende qué IP ve el rate limiting.
#   sin Docker (npm run dev)             → false: no hay proxy, y confiar en
#                                          X-Forwarded-For permitiría falsificar la IP
#   docker-compose.yml (desarrollo)      → 1: nginx. Lo fija el propio compose
#   docker-compose.prod.yml (producción) → 2: Caddy y nginx. Lo fija el propio compose
# No se admite "true": confiar en todas las cabeceras deja falsificar la IP del cliente.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# ---------------------------------------------------------------------------
# Las usa docker-compose.yml para crear el contenedor de Postgres
POSTGRES_USER=disagro
POSTGRES_PASSWORD=feria_demo_local
POSTGRES_DB=disagro_feria
# Puerto de la base publicado en el host (para desarrollar sin Docker, psql o Prisma
# Studio). 5434 y no 5432 porque el 5432 suele estar ocupado por otro Postgres.
POSTGRES_PORT=5434
# Conexión desde el HOST (npm run dev). Debe coincidir con los valores de arriba.
DATABASE_URL=postgresql://disagro:feria_demo_local@localhost:5434/disagro_feria?schema=public

# ---------------------------------------------------------------------------
# Autenticación
# ---------------------------------------------------------------------------
# Secreto de DEMO para local. En producción, uno nuevo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=demo-local-jwt-secret-no-usar-en-produccion-2026

# Admin del panel (/admin). Lo crea el seed; si cambias la contraseña, el siguiente
# seed actualiza el hash. Mínimo 12 caracteres y máximo 72 bytes.
ADMIN_USER=admin
ADMIN_PASSWORD=admin-demo-2026

# ---------------------------------------------------------------------------
# Correo (Resend)
# ---------------------------------------------------------------------------
# Vacía en local: la confirmación funciona igual, los códigos se ven en pantalla y el
# envío se omite con un aviso en el log. Con una clave real, se envía el respaldo.
RESEND_API_KEY=
MAIL_FROM=Feria Disagro <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Docker Compose (docker compose up -d --build)
# ---------------------------------------------------------------------------
# Solo para los contenedores. Dentro de la red de Docker la base NO está en
# localhost:5434, sino en el servicio `postgres`, puerto 5432.

# Puerto del host donde queda la app (nginx)
PUERTO_APP=8090
# Mismos usuario, contraseña y base que arriba, pero con host `postgres`
DATABASE_URL_DOCKER=postgresql://disagro:feria_demo_local@postgres:5432/disagro_feria?schema=public
# URL de la app servida por nginx (debe coincidir con PUERTO_APP)
APP_URL_DOCKER=http://localhost:8090

# ---------------------------------------------------------------------------
# Datos de demostración
# ---------------------------------------------------------------------------
# El seed crea 6 clientes de prueba (prisma/seed/demo.data.ts) para que el panel no
# arranque vacío. Solo crea los que falten, por email: nunca duplica ni modifica
# clientes existentes. `false` los omite.
#SEED_DEMO=false
