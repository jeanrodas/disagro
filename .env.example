# Copia este archivo a .env y reemplaza los valores ficticios.
# El archivo .env está en .gitignore: nunca lo subas al repositorio.

# --- Servidor ---
NODE_ENV=development
PORT=3000
# URL pública del frontend. CAMBIA EN CADA ENTORNO:
#   desarrollo → http://localhost:5175 (puerto del frontend con Vite)
#   producción → https://jeanrodas.lat (o el subdominio que se use)
# La usan el CORS, el enlace del correo de confirmación y el portafolioUrl del 409.
# Nunca se escribe en el código: siempre se lee de esta variable.
APP_URL=http://localhost:5175

# Proxies delante de la app. De esto depende qué IP cuenta el rate limiting.
#   desarrollo → false (no hay proxy; confiar en X-Forwarded-For permitiría falsificar la IP)
#   producción → 1 (un proxy delante), o "loopback", o la lista de IPs de los proxies
# No se admite "true": confiar en todas las cabeceras deja falsificar la IP del cliente.
TRUST_PROXY=false

# --- Base de datos (PostgreSQL) ---
# Usadas por docker-compose.yml para crear el contenedor de Postgres
POSTGRES_USER=disagro
POSTGRES_PASSWORD=cambiar_password
POSTGRES_DB=disagro_feria
POSTGRES_PORT=5432
# Usada por Prisma y el backend. Debe coincidir con los valores de arriba.
DATABASE_URL=postgresql://disagro:cambiar_password@localhost:5432/disagro_feria?schema=public

# --- Autenticación ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio

# --- Correo (Resend) ---
# Opcional: si se deja vacía, el correo de respaldo se omite (queda en el log)
# y la confirmación responde igual con los códigos.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Desarrollo: onboarding@resend.dev | Producción: feria@jeanrodas.lat
MAIL_FROM=Feria Disagro <onboarding@resend.dev>

# --- Admin inicial (solo lo usa el seed: npm run db:seed:admin o npx prisma db seed) ---
# El servidor arranca sin estas variables. Contraseña: mínimo 12 caracteres y máximo 72 bytes.
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar_esta_password

# ---------------------------------------------------------------------------
# Docker Compose (la plataforma completa: docker compose up -d --build)
# ---------------------------------------------------------------------------
# Estas variables son SOLO para los contenedores. Las de arriba siguen siendo las
# del desarrollo en el host, y por eso conviven: dentro de la red de Docker la
# base de datos NO está en localhost:5434, sino en el servicio `postgres`:5432.

# Puerto del host donde queda la app (nginx). Evita los ya usados: 3000, 5173,
# 5174, 5175, 5433, 5434.
PUERTO_APP=8090

# Conexión de los contenedores a la base. Usuario, contraseña y nombre deben
# coincidir con POSTGRES_USER, POSTGRES_PASSWORD y POSTGRES_DB de arriba.
DATABASE_URL_DOCKER=postgresql://disagro:cambiar_password@postgres:5432/disagro_feria?schema=public

# URL pública de la app para los contenedores. CAMBIA EN CADA ENTORNO:
#   local      -> http://localhost:8090 (debe coincidir con PUERTO_APP)
#   producción -> https://jeanrodas.lat
# La usan el CORS, el enlace del correo y el portafolioUrl del 409.
APP_URL_DOCKER=http://localhost:8090

# TRUST_PROXY no se define aquí: en el compose siempre vale 1, porque el backend
# va detrás de nginx. La variable de arriba es la del desarrollo sin Docker.

# ---------------------------------------------------------------------------
# PRODUCCIÓN (docker-compose.prod.yml: Caddy + HTTPS en el VPS)
# ---------------------------------------------------------------------------
# Producción NO usa este fichero: usa un .env.produccion aparte, que tampoco se
# versiona y se pasa de forma explícita:
#
#   docker compose -f docker-compose.prod.yml --env-file .env.produccion up -d --build
#
# Copia este bloque a ese fichero y cambia TODOS los valores. Los secretos de
# producción deben ser NUEVOS y aleatorios, nunca los de desarrollo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"        # JWT_SECRET
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"  # contraseñas

# --- Dominio y TLS (los usa Caddy) ---
DOMINIO=jeanrodas.lat
# Cuenta de Let's Encrypt: recibe los avisos de expiración. Nunca un correo real aquí.
CADDY_EMAIL=cambiar@por-tu-correo.real
# Solo si el 80 o el 443 ya están ocupados en la máquina. En el VPS se dejan como están.
#PUERTO_HTTP=80
#PUERTO_HTTPS=443

# --- App ---
# La usan el CORS, el enlace del correo y el portafolioUrl del 409
APP_URL_DOCKER=https://jeanrodas.lat

# --- Base de datos (mismos nombres que arriba, valores NUEVOS) ---
POSTGRES_USER=disagro
POSTGRES_PASSWORD=cambiar_password_de_produccion
POSTGRES_DB=disagro_feria
DATABASE_URL_DOCKER=postgresql://disagro:cambiar_password_de_produccion@postgres:5432/disagro_feria?schema=public

# --- Autenticación ---
JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio
# La contraseña del admin se aplica en cada `up`: el seed es idempotente y actualiza
# el hash si cambió. Rotarla es editar esta línea y volver a levantar.
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar_esta_password_de_produccion

# --- Correo (se completa en el paso de Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Feria Disagro <feria@jeanrodas.lat>

# TRUST_PROXY no se define aquí: docker-compose.prod.yml lo fija en 2, porque en esa
# topología hay dos proxies delante del backend (Caddy y nginx).

# ---------------------------------------------------------------------------
# Datos de demostración (desarrollo y producción)
# ---------------------------------------------------------------------------
# El seed crea 6 clientes de prueba (prisma/seed/demo.data.ts) para que el panel de
# administración no arranque vacío. Solo crea los que falten, por email: nunca
# duplica ni modifica clientes existentes. Por defecto se siembran; `false` los omite
# (por ejemplo, en un lanzamiento real donde no deben mezclarse con las métricas).
#SEED_DEMO=false
