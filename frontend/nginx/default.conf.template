# Frontend de la Feria Disagro servido por nginx.
#
# X-Forwarded-Proto: si la petición ya trae uno (hay un proxy delante que terminó el
# TLS, como Caddy en producción), se respeta; si no trae, se usa el esquema de esta
# conexión. Poner siempre $scheme borraría el "https" de Caddy, porque el salto
# Caddy→nginx es HTTP dentro de la red de Docker, y el backend creería que la
# petición llegó en claro.
#
# El `map` va en el contexto http, es decir fuera del bloque server.
map $http_x_forwarded_proto $esquema_de_origen {
    default $http_x_forwarded_proto;
    ""      $scheme;
}
#
# Es una PLANTILLA. Al arrancar el contenedor, el entrypoint oficial de nginx la
# procesa con envsubst y escribe el resultado en /etc/nginx/conf.d/default.conf.
# envsubst solo sustituye variables de entorno DEFINIDAS (BACKEND_HOST,
# BACKEND_PORT, NGINX_LOCAL_RESOLVERS): las variables propias de nginx ($uri,
# $host, $backend...) quedan intactas.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # No anunciar la versión de nginx en cabeceras ni en páginas de error
    server_tokens off;

    # Compresión. El JS y el CSS de Vite se reducen a una fracción de su tamaño.
    # text/html se comprime siempre; el resto hay que listarlo.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    # DNS de Docker (127.0.0.11 dentro de una red de compose), exportado por el
    # entrypoint oficial. Junto con el nombre del backend en una variable, obliga
    # a nginx a resolverlo en cada petición (con caché de 10 s) en vez de una sola
    # vez al arrancar. Así:
    #   - nginx arranca aunque el backend todavía no exista (si no, se negaría a
    #     arrancar con "host not found in upstream");
    #   - si el backend se recrea con otra IP, nginx la encuentra sin reiniciarse.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;


    # ---------------------------------------------------------------------------
    # API: todo /api/ va al backend
    # ---------------------------------------------------------------------------
    location /api/ {
        set $backend http://${BACKEND_HOST}:${BACKEND_PORT};
        # Sin URI tras $backend: la petición llega con su ruta original (/api/...),
        # que es la que espera el backend. Por lo mismo las cookies (Path=/api/admin
        # o Path=/) siguen valiendo tal cual: no hace falta proxy_cookie_path.
        proxy_pass $backend;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Dominio que pidió el navegador
        proxy_set_header Host $host;

        # IP real del cliente. $proxy_add_x_forwarded_for AÑADE la IP que ve nginx
        # al final de la cabecera. El backend, con TRUST_PROXY=1, confía en un solo
        # salto y toma ese último valor. Una X-Forwarded-For que invente el cliente
        # queda a la izquierda y se ignora: no sirve para saltarse el rate limiting.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;

        # Esquema con el que se pidió ORIGINALMENTE (ver el map de arriba)
        proxy_set_header X-Forwarded-Proto $esquema_de_origen;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        # El backend acepta cuerpos JSON de hasta 100 kB; 1 MB deja margen
        client_max_body_size 1m;

        # Si el backend no responde (caído, sin arrancar o sin DNS), nginx generaría
        # una página HTML de 502. Se sustituye por un 503 con el MISMO formato de
        # error que usa el backend, para que el frontend muestre un mensaje legible.
        # Los errores que devuelve el propio backend pasan sin tocar.
        error_page 502 503 504 = @backend_no_disponible;
    }

    location @backend_no_disponible {
        default_type "application/json; charset=utf-8";
        return 503 '{"error":{"message":"El servidor no está disponible en este momento. Inténtalo de nuevo en unos minutos."}}';
    }


    # ---------------------------------------------------------------------------
    # Assets con hash en el nombre (/assets/index-AbC123.js)
    # ---------------------------------------------------------------------------
    # El nombre cambia en cada build, así que se pueden cachear un año.
    # `expires` en lugar de add_header: así no se anulan las cabeceras incluidas.
    #
    # try_files ... =404: un asset que no existe devuelve 404 y NO index.html. Si
    # devolviera el HTML con un 200, el navegador intentaría ejecutarlo como JS
    # (típico al pedir un chunk de un deploy anterior).
    location /assets/ {
        include /etc/nginx/snippets/cabeceras-seguridad.conf;
        try_files $uri =404;
        expires 1y;
        access_log off;
    }

    # ---------------------------------------------------------------------------
    # index.html: nunca en caché
    # ---------------------------------------------------------------------------
    # Tras un deploy, el navegador vuelve a pedir el index y recibe los nombres de
    # los assets nuevos, sin que nadie tenga que vaciar la caché.
    location = /index.html {
        include /etc/nginx/snippets/cabeceras-seguridad.conf;
        expires -1;
    }

    # ---------------------------------------------------------------------------
    # SPA
    # ---------------------------------------------------------------------------
    # /portafolio, /admin o /admin/clientes/:id no existen como ficheros: se sirve
    # index.html y React Router decide qué pantalla mostrar. Sin este try_files,
    # recargar la página en cualquiera de esas rutas daría 404.
    location / {
        include /etc/nginx/snippets/cabeceras-seguridad.conf;
        try_files $uri $uri/ /index.html;
    }
}
