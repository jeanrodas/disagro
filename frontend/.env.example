# Copia este archivo a .env solo si necesitas apuntar a un backend remoto.
# Las variables VITE_* se incrustan en el bundle y son visibles para cualquiera
# que abra la página: aquí nunca van secretos.

# URL pública del backend, sin barra final (ej. https://api.jeanrodas.lat).
# En desarrollo se deja VACÍA: el proxy de Vite envía /api al backend local.
VITE_API_URL=
